{
  "name": "sbodak/magento2-b2b-disable-customer-registration",
  "description": "This extension allows you to disable customer registration in your Magento 2.",
  "keywords": ["magento2", "b2b", "disable registration"],
  "license": [
    "MIT"
  ],
  "type": "magento2-module",
  "version": "2.0.0",
  "authors": [
    {
      "name": "Slawomir Bodak",
      "email": "slawek.bodak@gmail.com"
    }
  ],
  "require": {
    "php": "~8.2.0||~8.3.0||~8.4.0",
    "magento/framework": "^103.0",
    "magento/module-customer": "^103.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "files": [
      "src/registration.php"
    ],
    "psr-4": {
      "Bodak\\DisableRegistration\\": "src/"
    }
  },
  "minimum-stability": "stable"
}
